# ---- Copy this file to ".env" and fill in your values. NEVER share or upload .env ----

# Gmail account that SENDS the OTP e-mails
MAIL_USERNAME=yourgmail@gmail.com
# 16-character Google App Password (NOT your normal Gmail password) - see README step 2
MAIL_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM_NAME=InvoiceFlow

# Comma separated e-mails allowed into the Admin panel
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com

# Optional
PORT=5001
OTP_TTL_MIN=5
# SECRET_KEY=   (auto-generated into .secret_key if empty)
